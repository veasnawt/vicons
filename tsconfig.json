{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "jsx": "react-jsx",

    "strict": true,
    "declaration": true,
    "declarationMap": true,

    "outDir": "dist",

    "esModuleInterop": true,
    "skipLibCheck": true,

    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src"
  ]
}